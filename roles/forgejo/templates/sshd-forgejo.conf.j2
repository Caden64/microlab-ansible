# Managed by Ansible for Forgejo on the MicroLab management host.
# System OpenSSH remains on port 22; Forgejo owns the git user's
# authorized_keys entries and their forced command.
Match User {{ micolab_forgejo_user }}
    AcceptEnv GIT_PROTOCOL
    AllowTcpForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTTY no
