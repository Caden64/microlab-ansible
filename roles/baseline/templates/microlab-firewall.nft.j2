#!/usr/sbin/nft -f
# Generated by MicroLab Ansible. Do not edit by hand.
#
# Ingress only. Loopback is always trusted so Caddy, step-ca, Forgejo, and the
# Technitium admin API can share the management host without exposing their
# loopback listeners. External DNS is restricted to the inventory's admin,
# client, and explicitly authoritative-only CIDRs. External HTTP/HTTPS is
# restricted to admin and client CIDRs only.
{% set dns_clients = (micolab_admin_cidrs + micolab_client_cidrs + micolab_dns_authoritative_only_cidrs) | unique | list %}
{% set web_clients = (micolab_admin_cidrs + micolab_client_cidrs) | unique | list %}
{% set ssh_clients = micolab_admin_cidrs | unique | list %}
{% set dns_clients6 = (micolab_admin_cidrs_v6 + micolab_client_cidrs_v6 + micolab_dns_authoritative_only_cidrs_v6) | unique | list %}
{% set web_clients6 = (micolab_admin_cidrs_v6 + micolab_client_cidrs_v6) | unique | list %}
{% set ssh_clients6 = micolab_admin_cidrs_v6 | unique | list %}
{% set ipv6_dns = dns_clients6 | length > 0 %}
{% set ipv6_web = web_clients6 | length > 0 %}
{% set ipv6_ssh = ssh_clients6 | length > 0 %}
{% set ipv6_any = ipv6_dns or ipv6_web or ipv6_ssh %}

table inet {{ micolab_firewall_table }} {
  set mgmt4 {
    type ipv4_addr
    flags interval
    elements = { {{ ssh_clients | join(', ') }} }
  }

  set dns_clients4 {
    type ipv4_addr
    flags interval
    elements = { {{ dns_clients | join(', ') }} }
  }

  set web_clients4 {
    type ipv4_addr
    flags interval
    elements = { {{ web_clients | join(', ') }} }
  }
{% if ipv6_dns %}

  set dns_clients6 {
    type ipv6_addr
    flags interval
    elements = { {{ dns_clients6 | join(', ') }} }
  }
{% endif %}
{% if ipv6_web %}

  set web_clients6 {
    type ipv6_addr
    flags interval
    elements = { {{ web_clients6 | join(', ') }} }
  }
{% endif %}
{% if ipv6_ssh %}

  set mgmt6 {
    type ipv6_addr
    flags interval
    elements = { {{ ssh_clients6 | join(', ') }} }
  }
{% endif %}

  chain input {
    type filter hook input priority filter; policy drop;

    iifname "lo" accept
    ct state established,related accept
    ct state invalid drop

{% if micolab_firewall_allow_icmp | bool %}
    ip protocol icmp accept
{% if ipv6_any %}
    ip6 nexthdr ipv6-icmp accept
{% endif %}
{% endif %}

    # SSH is retained from administrative networks only.
    ip saddr @mgmt4 tcp dport {{ micolab_ssh_port }} accept
{% if ipv6_ssh %}
    ip6 saddr @mgmt6 tcp dport {{ micolab_ssh_port }} accept
{% endif %}

    # Plain DNS (UDP and TCP/53) from lab/VPN clients and explicit
    # authoritative-only networks. Authoritative-only networks never enter the
    # Technitium recursion ACL.
    ip saddr @dns_clients4 udp dport {{ micolab_technitium_dns_port }} accept
    ip saddr @dns_clients4 tcp dport {{ micolab_technitium_dns_port }} accept
{% if ipv6_dns %}
    ip6 saddr @dns_clients6 udp dport {{ micolab_technitium_dns_port }} accept
    ip6 saddr @dns_clients6 tcp dport {{ micolab_technitium_dns_port }} accept
{% endif %}

    # HTTPS and HTTP for Caddy (admin UI, step-ca, git). DoH uses 443 too.
    # Authoritative-only DNS networks are deliberately not web clients.
    ip saddr @web_clients4 tcp dport { 80, 443 } accept
{% if ipv6_web %}
    ip6 saddr @web_clients6 tcp dport { 80, 443 } accept
{% endif %}

{% if micolab_dns_enable_dot | bool %}
    # DNS-over-TLS
    ip saddr @dns_clients4 tcp dport {{ micolab_dns_dot_port }} accept
{% if ipv6_dns %}
    ip6 saddr @dns_clients6 tcp dport {{ micolab_dns_dot_port }} accept
{% endif %}
{% endif %}
{% if micolab_dns_enable_doq | bool %}
    # DNS-over-QUIC
    ip saddr @dns_clients4 udp dport {{ micolab_dns_doq_port }} accept
{% if ipv6_dns %}
    ip6 saddr @dns_clients6 udp dport {{ micolab_dns_doq_port }} accept
{% endif %}
{% endif %}

    # Rate-limited deny logging prevents a query flood from filling the journal.
    limit rate 5/minute log prefix "micolab-drop " drop
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
